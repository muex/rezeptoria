{% extends 'base.html.twig' %}

{% block title %}Anmelden — Rezeptoria{% endblock %}

{% block body %}
    <div class="mx-auto flex max-w-md flex-col px-6 pb-16 pt-16">
        <div class="rounded-3xl bg-white p-6 shadow-[0_1px_3px_rgba(0,0,0,0.06)] ring-1 ring-black/5 sm:p-8">
            <h1 class="text-2xl font-semibold tracking-tight text-[#1d1d1f]">Anmelden</h1>
            <p class="mt-2 text-sm text-gray-500">Schön, dich wiederzusehen.</p>

            <form class="mt-8 space-y-5" method="post">
                {% if error %}
                    <p class="rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700 ring-1 ring-red-100">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </p>
                {% endif %}
                {% if app.user %}
                    <p class="rounded-xl bg-[#f5f5f7] px-4 py-3 text-sm text-gray-600">
                        Du bist bereits als <span class="font-medium text-[#1d1d1f]">{{ app.user.userIdentifier }}</span> angemeldet.
                        <a href="{{ path('app_logout') }}" class="font-medium text-pinegreen hover:text-pinegreen-40">Abmelden</a>
                    </p>
                {% endif %}

                <div>
                    <label for="username" class="mb-1 block text-sm font-medium text-gray-700">Benutzername</label>
                    <input
                            type="text"
                            class="form-input"
                            placeholder="Benutzername"
                            value="{{ last_username }}"
                            name="_username"
                            id="username"
                            autocomplete="username"
                            required
                    />
                </div>

                <div>
                    <label for="password" class="mb-1 block text-sm font-medium text-gray-700">Passwort</label>
                    <input
                            type="password"
                            class="form-input"
                            placeholder="••••••••"
                            name="_password"
                            id="password"
                            autocomplete="current-password"
                            required
                    />
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <!--<div class="flex items-center justify-between">
                    <label class="flex items-center gap-2">
                        <input type="checkbox" class="form-check"/>
                        <span class="text-sm text-gray-600">Angemeldet bleiben</span>
                    </label>
                    <a href="#" class="text-sm font-medium text-pinegreen hover:text-pinegreen-40">Passwort vergessen?</a>
                </div> -->

                <button type="submit" class="btn btn-primary w-full">
                    Anmelden
                </button>
            </form>

            <p class="mt-6 text-center text-sm text-gray-500">
                Keinen Account?
                <a href="{{ path('app_register') }}" class="font-medium text-pinegreen hover:text-pinegreen-40">Registrieren</a>
            </p>
        </div>
    </div>
{% endblock %}
