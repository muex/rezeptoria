{% extends 'base.html.twig' %}

{% block title %}Registrieren — Rezeptoria{% endblock %}

{% block body %}
<div class="mx-auto flex max-w-md flex-col px-6 pb-16 pt-16">
    <div class="rounded-3xl bg-white p-6 shadow-[0_1px_3px_rgba(0,0,0,0.06)] ring-1 ring-black/5 sm:p-8">
        <h1 class="text-2xl font-semibold tracking-tight text-[#1d1d1f]">Registrieren</h1>
        <p class="mt-2 text-sm text-gray-500">Leg los und teile deine Rezepte.</p>

        {{ form_start(registrationForm, {'attr': {'class': 'mt-8 space-y-5'}}) }}
            <div>
                {{ form_label(registrationForm.username, 'Benutzername') }}
                {{ form_widget(registrationForm.username) }}
                {{ form_errors(registrationForm.username) }}
            </div>
            <div>
                {{ form_label(registrationForm.plainPassword, 'Passwort') }}
                {{ form_widget(registrationForm.plainPassword) }}
                {{ form_errors(registrationForm.plainPassword) }}
            </div>

            <div>
                <div class="flex items-center gap-2">
                    {{ form_widget(registrationForm.agreeTerms) }}
                    {{ form_label(registrationForm.agreeTerms, 'Ich stimme den Nutzungsbedingungen zu', {'label_attr': {'class': 'text-sm text-gray-700'}}) }}
                </div>
                {{ form_errors(registrationForm.agreeTerms) }}
            </div>

            <button type="submit" class="btn btn-primary w-full">
                Registrieren
            </button>
        {{ form_end(registrationForm) }}

        <p class="mt-6 text-center text-sm text-gray-500">
            Bereits ein Konto?
            <a href="{{ path('app_login') }}" class="font-medium text-pinegreen hover:text-pinegreen-40">Anmelden</a>
        </p>
    </div>
</div>
{% endblock %}
