{# templates/form/tailwind_theme.html.twig #}

{% use 'form_div_layout.html.twig' %}

{%- block form_row -%}
    <div class="mb-5">
        {{- form_label(form) -}}
        {{- form_widget(form) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock form_row -%}

{# An explicit label_attr.class replaces the default instead of being appended to
   it, so inline labels (checkboxes) are not forced to `block … mb-1`. #}
{%- block form_label -%}
    {%- set label_attr = label_attr|merge({class: label_attr.class|default('block text-sm font-medium text-gray-700 mb-1')|trim}) -%}
    {{- parent() -}}
{%- endblock form_label -%}

{# `form-input` is a component class, so widths and paddings passed in by the
   caller (w-20, py-1) still win over it. #}
{%- block form_widget_simple -%}
    {# hidden_widget routes through this block too — don't style what is never shown. #}
    {%- if type|default('text') != 'hidden' -%}
        {%- set attr = attr|merge({class: (attr.class|default('') ~ ' form-input')|trim}) -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock form_widget_simple -%}

{%- block textarea_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' form-input')|trim}) -%}
    {{- parent() -}}
{%- endblock textarea_widget -%}

{%- block choice_widget_expanded -%}
    <div class="mt-1 flex flex-wrap gap-x-6 gap-y-3">
        {% for child in form %}
            <div class="flex items-center gap-2">
                {{ form_widget(child) }}
                {{ form_label(child, null, {label_attr: {'class': 'text-sm text-gray-700'}}) }}
            </div>
        {% endfor %}
    </div>
{%- endblock choice_widget_expanded -%}

{%- block checkbox_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' form-check')|trim}) -%}
    {{- parent() -}}
{%- endblock checkbox_widget -%}

{%- block form_errors -%}
    {% if errors|length > 0 %}
        <p class="mt-2 text-sm text-red-600">
            {% for error in errors %}
                {{ error.message }}
            {% endfor %}
        </p>
    {% endif %}
{%- endblock form_errors -%}

{%- block button_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('btn btn-primary'))|trim}) -%}
    <button type="{{ type|default('button') }}" {{ block('button_attributes') }}>
        {{- label|default(button_label) -}}
    </button>
{%- endblock button_widget -%}
