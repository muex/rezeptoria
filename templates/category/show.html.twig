{% extends 'base.html.twig' %}

{% block title %}{{ category.name }} — Kategorien{% endblock %}

{% block body %}
<div class="mx-auto max-w-3xl px-6 pb-16 pt-10">

    <a href="{{ path('app_category_index') }}"
       class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-500 transition-colors hover:text-pinegreen">
        <span aria-hidden="true">←</span> Zurück zu den Kategorien
    </a>

    <div class="mt-6 rounded-3xl bg-white p-6 shadow-[0_1px_3px_rgba(0,0,0,0.06)] ring-1 ring-black/5 sm:p-10">
        <p class="text-sm font-medium uppercase tracking-[0.12em] text-pinegreen">Kategorie</p>
        <h1 class="mt-2 text-2xl font-semibold tracking-tight text-[#1d1d1f] sm:text-3xl">{{ category.name }}</h1>

        <h2 class="mt-8 text-sm font-semibold uppercase tracking-[0.12em] text-gray-500">
            Rezepte <span class="text-gray-400">{{ category.recipes|length }}</span>
        </h2>

        {% if category.recipes|length > 0 %}
            <ul class="mt-3 divide-y divide-black/5">
                {% for recipe in category.recipes %}
                    <li class="py-3 first:pt-0 last:pb-0">
                        <a href="{{ path('app_recipe_show', {'id': recipe.id}) }}"
                           class="font-medium text-[#1d1d1f] transition-colors hover:text-pinegreen">
                            {{ recipe.title }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="mt-3 text-sm text-gray-500">Dieser Kategorie ist noch kein Rezept zugeordnet.</p>
        {% endif %}

        <div class="mt-10 flex flex-wrap items-center gap-3 border-t border-black/5 pt-6">
            <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="btn btn-outline">Bearbeiten</a>
            {{ include('category/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}
