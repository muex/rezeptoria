{% extends 'base.html.twig' %}

{% block title %}Neue Kategorie — Rezeptoria{% endblock %}

{% block body %}
<div class="mx-auto max-w-lg px-6 pb-16 pt-10">

    <a href="{{ path('app_category_index') }}"
       class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-500 transition-colors hover:text-pinegreen">
        <span aria-hidden="true">←</span> Zurück zu den Kategorien
