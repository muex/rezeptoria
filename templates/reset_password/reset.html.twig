{% extends 'base.html.twig' %}

{% block title %}Neues Passwort setzen — Rezeptoria{% endblock %}

{% block body %}
    <div class="mx-auto flex max-w-md flex-col px-6 pb-16 pt-16">
        <div class="rounded-3xl bg-white p-6 shadow-[0_1px_3px_rgba(0,0,0,0.06)] ring-1 ring-black/5 sm:p-8">
            <h1 class="text-2xl font-semibold tracking-tight text-[#1d1d1f]">Neues Passwort setzen</h1>
            <p class="mt-2 text-sm text-gray-500">Danach bist du direkt angemeldet.</p>

            {{ form_start(resetForm, {'attr': {'class': 'mt-8 space-y-5'}}) }}
                {{ form_row(resetForm.plainPassword.first) }}
                {{ form_row(resetForm.plainPassword.second) }}
                <button class="btn btn-primary w-full">Passwort speichern</button>
            {{ form_end(resetForm) }}
        </div>
    </div>
{% endblock %}
