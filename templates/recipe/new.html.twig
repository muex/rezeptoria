{% extends 'base.html.twig' %}

{% block title %}Neues Rezept — Rezeptoria{% endblock %}

{% block body %}
<div class="mx-auto max-w-3xl px-6 pb-16 pt-10">

    <a href="{{ path('app_recipe_index') }}"
       class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-500 transition-colors hover:text-pinegreen">
        <span aria-hidden="true">←</span> Zurück zur Übersicht
    </a>

    <div class="mt-6 rounded-3xl bg-white p-6 shadow-[0_1px_3px_rgba(0,0,0,0.06)] ring-1 ring-black/5 sm:p-10">
        <h1 class="text-2xl font-semibold tracking-tight text-[#1d1d1f] sm:text-3xl">Neues Rezept</h1>
        <p class="mt-2 text-sm text-gray-500">
            Teile dein Lieblingsrezept — Abschnitt für Abschnitt.
        </p>

        <div class="mt-8">
            {{ include('recipe/_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}
