{% extends 'base.html.twig' %}

{% block title %}Rezept bearbeiten — Rezeptoria{% endblock %}

{% block body %}
<div class="mx-auto max-w-3xl px-6 pb-16 pt-10">

    <a href="{{ path('app_recipe_show', {'slug': recipe.slug}) }}"
       class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-500 transition-colors hover:text-pinegreen">
        <span aria-hidden="true">←</span> Zurück zum Rezept
    </a>

    <div class="mt-6 rounded-3xl bg-white p-6 shadow-[0_1px_3px_rgba(0,0,0,0.06)] ring-1 ring-black/5 sm:p-10">
        <h1 class="text-2xl font-semibold tracking-tight text-[#1d1d1f] sm:text-3xl">Rezept bearbeiten</h1>
        <p class="mt-2 text-sm text-gray-500">{{ recipe.title }}</p>

        <div class="mt-8">
            {{ include('recipe/_form.html.twig', {'button_label': 'Änderungen speichern'}) }}
        </div>
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-4 rounded-3xl bg-white/60 p-6 ring-1 ring-black/5">
        <div>
            <p class="text-sm font-medium text-[#1d1d1f]">Rezept löschen</p>
            <p class="mt-1 text-sm text-gray-500">Diese Aktion lässt sich nicht rückgängig machen.</p>
        </div>
        {{ include('recipe/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
