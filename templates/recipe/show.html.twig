{% extends 'base.html.twig' %}

{% block title %}{{ recipe.title }} — Rezeptoria{% endblock %}

{% block body %}
<div class="mx-auto max-w-3xl px-6 pb-16 pt-10">

    <a href="{{ path('app_recipe_index') }}"
       class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-500 transition-colors hover:text-pinegreen">
        <span aria-hidden="true">←</span> Zurück zur Übersicht
    </a>

    <article class="mt-6 rounded-3xl bg-white p-6 shadow-[0_1px_3px_rgba(0,0,0,0.06)] ring-1 ring-black/5 sm:p-10">

        {% if not recipe.publiclyVisible %}
            <div class="mb-5 flex flex-wrap items-center gap-3 rounded-2xl bg-[#f5f5f7] px-5 py-4 ring-1 ring-black/5">
                {{ include('recipe/_status_badge.html.twig') }}
                <p class="text-sm text-gray-500">
                    {% if recipe.blockedByAdmin %}
                        Dieses Rezept wurde von einem Administrator gesperrt und kann nur von diesem wieder freigegeben werden.
                    {% else %}
                        Dieses Rezept ist derzeit nicht öffentlich.
                    {% endif %}
                </p>
            </div>
        {% endif %}

        {% if recipe.categories|length > 0 %}
            <div class="mb-4 flex flex-wrap gap-2">
                {% for category in recipe.categories %}
                    <span class="rounded-full bg-pinegreen/10 px-3 py-1 text-xs font-medium text-pinegreen">
                        {{ category.name }}
                    </span>
                {% endfor %}
            </div>
        {% endif %}

        <h1 class="text-3xl font-semibold tracking-tight text-[#1d1d1f] sm:text-4xl">{{ recipe.title }}</h1>

        {% if recipe.text %}
            <p class="mt-4 text-lg leading-relaxed text-gray-500">{{ recipe.text }}</p>
        {% endif %}

        {% if recipe.teaserImage %}
            <img src="{{ asset('uploads/images/' ~ recipe.teaserImage) }}" alt="{{ recipe.title }}"
                 class="mt-8 aspect-[16/9] w-full rounded-2xl object-cover ring-1 ring-black/5">
        {% endif %}

        {# ── Sections (new structured data) ───────────────────── #}
        {% if recipe.sections|length > 0 %}

            {# Portion calculator #}
            <div class="mt-8 flex w-fit items-center gap-3 rounded-2xl bg-[#f5f5f7] px-4 py-3 ring-1 ring-black/5">
                <span class="text-sm font-medium text-gray-700">Portionen</span>
                <button type="button" id="btn-decrease" aria-label="Weniger Portionen"
                        class="flex h-8 w-8 items-center justify-center rounded-full bg-white text-lg font-medium text-gray-600 ring-1 ring-black/5 transition-colors hover:text-pinegreen">−</button>
                <span id="current-servings" class="w-8 text-center font-semibold tabular-nums text-[#1d1d1f]"
                      data-base="{{ recipe.baseServings }}">{{ recipe.baseServings }}</span>
                <button type="button" id="btn-increase" aria-label="Mehr Portionen"
                        class="flex h-8 w-8 items-center justify-center rounded-full bg-white text-lg font-medium text-gray-600 ring-1 ring-black/5 transition-colors hover:text-pinegreen">+</button>
            </div>

            {% for section in recipe.sections %}
                <section class="mt-10">
                    <h2 class="border-b border-black/5 pb-2 text-xl font-semibold tracking-tight text-[#1d1d1f]">
                        {{ section.title }}
                    </h2>

                    {% if section.ingredients|length > 0 %}
                        <h3 class="mt-5 text-sm font-semibold uppercase tracking-[0.12em] text-gray-500">Zutaten</h3>
                        <ul class="mt-3 space-y-1.5">
                            {% for ingredient in section.ingredients %}
                                <li class="grid grid-cols-[3.5rem_4.5rem_1fr] items-baseline gap-2 text-gray-700">
                                    <span class="{{ ingredient.amount ? 'ingredient-amount' : '' }} text-right font-medium tabular-nums text-[#1d1d1f]"
                                          {% if ingredient.amount %}data-base-amount="{{ ingredient.amount }}"{% endif %}>
                                        {%- if ingredient.amount -%}
                                            {{ ingredient.amount|number_format(ingredient.amount == ingredient.amount|round ? 0 : 2, ',', '.') }}
                                        {%- endif -%}
                                    </span>
                                    <span class="text-gray-500">{{ ingredient.unit }}</span>
                                    <span>{{ ingredient.name }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}

                    {% if section.preparation %}
                        <h3 class="mt-6 text-sm font-semibold uppercase tracking-[0.12em] text-gray-500">Zubereitung</h3>
                        <p class="mt-3 whitespace-pre-line leading-relaxed text-gray-700">{{ section.preparation }}</p>
                    {% endif %}
                </section>
            {% endfor %}

        {% else %}
            {# ── Fallback for old plain-text recipes ─────────── #}
            {% if recipe.ingredients %}
                <h3 class="mt-8 text-sm font-semibold uppercase tracking-[0.12em] text-gray-500">Zutaten</h3>
                <p class="mt-3 whitespace-pre-line leading-relaxed text-gray-700">{{ recipe.ingredients }}</p>
            {% endif %}
        {% endif %}

        {% if app.user == recipe.owner %}
            <div class="mt-10 flex flex-wrap items-center gap-3 border-t border-black/5 pt-6">
                <a href="{{ path('app_recipe_edit', {'id': recipe.id}) }}" class="btn btn-outline">Bearbeiten</a>
                {% if is_granted('RECIPE_TOGGLE_ACTIVE', recipe) %}
                    <form method="post" action="{{ path('app_recipe_toggle_active', {'id': recipe.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('toggle-active' ~ recipe.id) }}">
                        <button class="btn btn-outline">
                            {{ recipe.active ? 'Deaktivieren' : 'Aktivieren' }}
                        </button>
                    </form>
                {% endif %}
                {{ include('recipe/_delete_form.html.twig') }}
            </div>
        {% endif %}
    </article>

    {% if ad_code|trim %}
        <div class="my-10">
            {{ include('partials/_ad.html.twig', { format: 'leaderboard' }) }}
        </div>
    {% endif %}

    {# ── Comments ─────────────────────────────────────────────── #}
    <section class="mt-10 rounded-3xl bg-white p-6 shadow-[0_1px_3px_rgba(0,0,0,0.06)] ring-1 ring-black/5 sm:p-10">
        <h2 class="text-xl font-semibold tracking-tight text-[#1d1d1f]">
            Kommentare
            <span class="ml-1 text-base font-normal text-gray-400">{{ recipe.comments|length }}</span>
        </h2>

        {% if recipe.comments|length > 0 %}
            <ul class="mt-6 divide-y divide-black/5">
                {% for comment in recipe.comments %}
                    <li class="py-4 first:pt-0 last:pb-0">
                        <p class="leading-relaxed text-gray-700">{{ comment.text }}</p>
                        <p class="mt-1.5 text-xs text-gray-400">
                            {{ comment.createdUser.username }} · {{ comment.createdAt|date('d.m.Y H:i') }}
                        </p>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="mt-4 text-sm text-gray-500">Noch keine Kommentare — sei der Erste.</p>
        {% endif %}

        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
            <div class="mt-8 border-t border-black/5 pt-6">
                {{ render(controller('App\\Controller\\RecipeController::commentForm', {'recipe': recipe.id})) }}
            </div>
        {% else %}
            <p class="mt-6 border-t border-black/5 pt-6 text-sm text-gray-500">
                Du musst <a href="{{ path('app_login') }}" class="font-medium text-pinegreen hover:text-pinegreen-40">angemeldet</a> sein, um einen Kommentar zu schreiben.
            </p>
        {% endif %}
    </section>
</div>

{% if recipe.sections|length > 0 %}
<script>
(function () {
    var baseServings    = {{ recipe.baseServings|json_encode }};
    var currentServings = baseServings;
    var servingsEl      = document.getElementById('current-servings');
    var amountEls       = document.querySelectorAll('.ingredient-amount');

    function formatAmount(value) {
        if (value === 0) return '—';
        var rounded = Math.round(value * 100) / 100;
        return rounded % 1 === 0 ? rounded.toString() : rounded.toFixed(2).replace('.', ',');
    }

    function updateAmounts() {
        servingsEl.textContent = currentServings;
        amountEls.forEach(function (el) {
            var base = parseFloat(el.dataset.baseAmount);
            el.textContent = formatAmount(base * currentServings / baseServings);
        });
    }

    document.getElementById('btn-decrease').addEventListener('click', function () {
        if (currentServings > 1) { currentServings--; updateAmounts(); }
    });
    document.getElementById('btn-increase').addEventListener('click', function () {
        currentServings++; updateAmounts();
    });
}());
</script>
{% endif %}
{% endblock %}
