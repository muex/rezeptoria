{# Status badge for recipes that are not publicly visible.
   Only rendered where the viewer is allowed to see the recipe at all. #}
{% if recipe.blockedByAdmin %}
    <span class="inline-flex items-center gap-1 rounded-full bg-red-50 px-3 py-1 text-xs font-medium text-red-600 ring-1 ring-red-200">
        <span aria-hidden="true">⛔</span> Vom Admin gesperrt
    </span>
{% elseif not recipe.active %}
    <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-3 py-1 text-xs font-medium text-amber-700 ring-1 ring-amber-200">
        <span aria-hidden="true">👁</span> Deaktiviert — nur für dich sichtbar
    </span>
{% elseif not recipe.owner.active %}
    <span class="inline-flex items-center gap-1 rounded-full bg-red-50 px-3 py-1 text-xs font-medium text-red-600 ring-1 ring-red-200">
        <span aria-hidden="true">⛔</span> Konto deaktiviert
    </span>
{% endif %}
